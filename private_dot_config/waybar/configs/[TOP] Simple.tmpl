{{- $gui_packages := dig .osid "gui" ( list ) .packages }}
{{- $workspace_module := ternary "hyprland/workspaces#rw" "sway/workspaces#rw" (has "hyprland" $gui_packages) }}
// ### TOP Simple ## //

{
"include": [
  "$HOME/.config/waybar/Modules",
  "$HOME/.config/waybar/ModulesWorkspaces",
  "$HOME/.config/waybar/ModulesCustom",
  "$HOME/.config/waybar/ModulesGroups",
  "$HOME/.config/waybar/UserModules",
  ],
"layer": "top", 
"position": "top", 
//"mode": "dock",
"exclusive": true,
"passthrough": false,
"gtk-layer-shell": true,
"margin-left": 6,
"margin-right": 6,
"margin-top": 2,

"modules-left": [	
	"idle_inhibitor", 
	"group/mobo_drawer",
	"{{ $workspace_module }}",
	"tray",
	"mpris", 
	],
    
"modules-center": [
	"clock#2",
	"group/notify",
	],
    
"modules-right": [
	"hyprland/window",  
	"battery",
 	"group/audio", 
	"custom/power",
	],
}

