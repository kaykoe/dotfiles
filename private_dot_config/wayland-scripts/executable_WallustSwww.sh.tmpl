#!/bin/bash
# /* ---- 💫 https://github.com/JaKooLit 💫 ---- */  ##
# Wallust Colors for current wallpaper

set -euo pipefail

{{- $gui_packages := dig .osid "gui" ( list ) .packages }}
{{- $is_hyprland := has "hyprland" $gui_packages }}
{{- $is_sway := has "sway" $gui_packages }}

# Define the path to the swww cache directory
PATH="$HOME/.local/bin:$HOME/.cargo/bin:$PATH"

{{- $wallpaper_command := "awww" }}
{{- if has "swww" $gui_packages }}
{{- $wallpaper_command = "swww" }}
{{- end }}
wallpaper_command="{{ $wallpaper_command }}"
wallpaper_path="${1:-}"

{{- if $is_hyprland }}
# Get current focused monitor
current_monitor=$(hyprctl monitors -j | jq -r '.[] | select(.focused) | .name')
{{- else if $is_sway }}
# Get current focused monitor
current_monitor=$(swaymsg -t get_outputs | jq -r '.[] | select(.focused) | .name')
{{- end }}
if [[ -z "$wallpaper_path" ]]; then
{{- if has "swww" $gui_packages }}
	cache_file="$HOME/.cache/swww/$current_monitor"
{{- else }}
	cache_file=$(printf '%s\n' "$HOME"/.cache/awww/*/"$current_monitor" | sort -V | tail -n 1)
{{- end }}

	if [[ -f "$cache_file" ]]; then
		wallpaper_path=$(tr '\0' '\n' <"$cache_file" | awk '/^\// { print; exit }')
	fi
fi

if [[ ! -f "$wallpaper_path" && -f "$HOME/.config/wallpaper/current" ]]; then
	wallpaper_path="$HOME/.config/wallpaper/current"
fi

if [[ ! -f "$wallpaper_path" ]]; then
	echo "Unable to determine the current wallpaper." >&2
	exit 1
fi

ln -sf "$wallpaper_path" "$HOME/.config/rofi/.current_wallpaper"
cp -f "$wallpaper_path" "$HOME/.config/wallpaper/current"

wallust_config="$HOME/.config/wallust/wallust.toml"
wallust_config_backup=$(mktemp)
cp "$wallust_config" "$wallust_config_backup"
trap 'cp "$wallust_config_backup" "$wallust_config"; rm -f "$wallust_config_backup"' EXIT

# Render graphical targets, but leave terminal-specific templates unchanged.
sed -Ei 's/^#((\w+)\.(target|template) = .*$)/\1/' "$wallust_config"
sed -Ei 's/^((kitty|neopywal)\.(target|template) = .*$)/#\1/' "$wallust_config"
wallust run "$wallpaper_path" -s

pkill -SIGUSR2 waybar 2>/dev/null || true
